      "item": [
        {
          "name": "Login Mahasiswa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response is valid JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('token exists', function () {",
                  "  pm.expect(json.data, 'data').to.be.an('object');",
                  "  pm.expect(json.data.token, 'data.token').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('mahasiswa_token', json.data.token);",
                  "}",
                  "",
                  "pm.test('response time below 5000 ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mahasiswa_email}}\",\n  \"password\": \"{{mahasiswa_password}}\"\n}"
