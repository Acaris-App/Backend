    {
      "name": "Acaris Bot",
      "item": [
        {
          "name": "Test - Ambil History Chat / Generate Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status code is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "pm.test('response contains summary field', function () {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body, 'n8n response body kosong. Pastikan node Respond to Webhook mengembalikan JSON.').to.not.be.empty;",
                  "  const contentType = pm.response.headers.get('Content-Type') || '';",
                  "  pm.expect(contentType, 'Content-Type harus application/json dari Respond to Webhook.').to.include('application/json');",
                  "  const json = pm.response.json();",
                  "  const payload = Array.isArray(json) ? json[0] : json;",
                  "  pm.expect(payload).to.be.an('object');",
                  "  pm.expect(",
                  "    payload.draft_summary || payload.summary || payload.ringkasan || payload.output || payload.message || payload.response",
                  "  ).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"generate_summary\",\n  \"session_id\": \"{{chatbot_session_id}}\",\n  \"npm_mahasiswa\": \"{{npm_mahasiswa}}\",\n  \"messages\": [\n    {\n      \"id\": 1,\n      \"sender\": \"user\",\n      \"text\": \"Saya ingin konsultasi tentang revisi Bab 4.\",\n      \"created_at\": \"2026-05-29T07:00:00.000Z\"\n    },\n    {\n      \"id\": 2,\n      \"sender\": \"bot\",\n      \"text\": \"Baik, fokuskan pembahasan pada hasil pengujian dan bukti CI/CD.\",\n      \"created_at\": \"2026-05-29T07:01:00.000Z\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{n8n_base_url}}/webhook-test/{{n8n_generate_summary_webhook_id}}/chatbot/session/{{chatbot_session_id}}/generate-summary",
              "host": [
                "{{n8n_base_url}}"
              ],
              "path": [
                "webhook-test",
                "{{n8n_generate_summary_webhook_id}}",
                "chatbot",
                "session",
                "{{chatbot_session_id}}",
                "generate-summary"
              ]
            },
            "description": "Klik Execute workflow di n8n untuk workflow ambil history/generate summary, lalu kirim request ini. Body mengikuti payload yang dikirim backend ke n8n."
          },
          "response": []
        },
